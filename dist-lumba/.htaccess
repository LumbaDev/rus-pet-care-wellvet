# 1. Rutas para SPA (Single Page Application)
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Si el archivo o directorio existe, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Redirigir todas las rutas a index.html
  RewriteRule ^ index.html [L]
</IfModule>

# 2. Tipos MIME
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

# 3. Cabeceras de seguridad
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# 4. Compresión Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# 5. Estrategia de Caché (IMPORTANTE)
<IfModule mod_expires.c>
  ExpiresActive On

  # Regla general para assets estáticos (Imágenes, CSS, JS)
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # EXCEPCIÓN PARA INDEX.HTML: 
  # Forzamos que expire inmediatamente para que siempre busque cambios.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 6. Forzar validación de index.html (Evita el "caché persistente")
<FilesMatch "index\.html$">
  <IfModule mod_headers.c>
    # Le dice al navegador: "No guardes esto, y si lo haces, pregunta si cambió"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </IfModule>
</FilesMatch>